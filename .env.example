# Modèle LLM cible — format litellm.
# Exemples :
#   anthropic/claude-sonnet-5              (défaut)
#   anthropic/claude-3-haiku-20240307
#   openai/gpt-5.4-mini                    (reasoning model récent)
#   openai/gpt-4o
#   openai/gpt-4o-mini
#   azure/<deployment-name>
LLM_MODEL=anthropic/claude-sonnet-5

# Clés API selon le provider utilisé. litellm lit automatiquement la bonne
# variable selon le préfixe de LLM_MODEL.
ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...

# Pour les modèles reasoning (gpt-5.4-mini, o3-mini, o1, etc.) :
# laisser vide pour les modèles non-reasoning.
#   low    : peu de "thinking", rapide, bon marché
#   medium : équilibré
#   high   : reasoning approfondi, plus lent, plus cher
# REASONING_EFFORT=medium

# Tuning (optionnel)
# TEMPERATURE=0
# MAX_TOKENS=8192
# MAX_RETRIES=2

# ── API HTTP (mode async pour Polaris) ───────────────────────────────────────
# Secret partagé que l'appelant doit envoyer dans le header X-Shared-Secret.
# Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Laisser vide en local pour désactiver l'auth.
CV_AGENT_SHARED_SECRET=

# Concurrence du ThreadPoolExecutor de /jobs (rate limit Anthropic ~50/min).
MAX_CONCURRENT_JOBS=3
